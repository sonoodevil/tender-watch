<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tender Watch Dashboard</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #111827;
      --muted: #94a3b8;
      --text: #e2e8f0;
      --accent: #38bdf8;
      --accent-2: #22c55e;
      --border: #334155;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: 24px;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 24px;
      font-size: 2rem;
    }

    .status {
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }

    .title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
      line-height: 1.4;
    }

    .meta {
      color: var(--muted);
      font-size: 0.82rem;
      margin: 4px 0;
    }

    .link {
      display: inline-block;
      margin-top: 10px;
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .link:hover {
      text-decoration: underline;
    }

    .empty {
      padding: 20px;
      border: 1px dashed var(--border);
      color: var(--muted);
      border-radius: 12px;
      text-align: center;
      background: rgba(15, 23, 42, 0.5);
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Tender Watch</h1>
    <div class="status" id="status">Loading alerts...</div>
    <div id="alerts"></div>
  </div>

  <script src="./app.js"></script>
</body>
</html>
"""},{"content":"async function loadAlerts() {
  const container = document.getElementById('alerts');
  const status = document.getElementById('status');

  try {
    const response = await fetch('./data/alerts.json', { cache: 'no-store' });
    if (!response.ok) {
      throw new Error('Could not load alerts.json');
    }

    const alerts = await response.json();

    if (!Array.isArray(alerts) || alerts.length === 0) {
      status.textContent = 'No alerts found yet.';
      container.innerHTML = '<div class="empty">No data available. The scraper will populate this file automatically.</div>';
      return;
    }

    status.textContent = `${alerts.length} alert(s) found.`;

    container.innerHTML = alerts
      .slice()
      .reverse()
      .map(item => `
        <div class="card">
          <div class="title">${escapeHtml(item.title || 'Untitled tender')}</div>
          <div class="meta">Source: ${escapeHtml(item.source || 'Unknown')}</div>
          <div class="meta">Added: ${escapeHtml(item.added_at || item.date || 'N/A')}</div>
          <a class="link" href="${escapeAttribute(item.url || '#')}" target="_blank" rel="noopener noreferrer">
            Open tender link
          </a>
        </div>
      `)
      .join('');
  } catch (error) {
    status.textContent = 'Unable to load data.';
    container.innerHTML = '<div class="empty">Check if the scraper has generated alerts.json.</div>';
    console.error(error);
  }
}

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function escapeAttribute(value) {
  return escapeHtml(value);
}

loadAlerts();
setInterval(loadAlerts, 300000);
"""},{"content":"name: Tender Watch

on:
  schedule:
    - cron: '0 21 * * *'
  workflow_dispatch:

jobs:
  tender-check:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run scraper
        run: python scraper.py

      - name: Commit updated data
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/alerts.json
          if git diff --cached --quiet; then
            echo "No changes to commit."
            exit 0
          fi
          git commit -m "Update tender alerts"
          git push
